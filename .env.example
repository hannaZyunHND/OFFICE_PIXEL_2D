# =========================================================
# Pixel Agent Office — Environment Variables Template
# Copy file này thành `.env` và điền 3 API Key cá nhân của bạn
# =========================================================
VITE_PORT=34213
VITE_CREWAI_PORT=34214
VITE_CREWAI_WS_URL=ws://localhost:34214
VITE_CREWAI_HTTP_URL=http://localhost:34214

CREWAI_HOST=localhost
CREWAI_PORT=34214

# External Market Data API Keys (Product Hunter Crew)
ADDLIVETAG_API_KEY=
APIFY_API_TOKEN=
SERPER_API_KEY=

# Optional Apify Actor IDs
APIFY_LAZADA_ACTOR=memo23~lazada-scraper
APIFY_TIKTOK_ACTOR=pro100chok~tiktok-shop-scraper-usage

# Đăng báo cáo HTML lên GitHub Pages sau mỗi lần Product Hunter chạy xong.
# auto = dùng tài khoản GitHub mà git đã đăng nhập. off = không đăng.
# REPORT_PUBLISH=auto
# REPORT_GITHUB_REPO=owner/pixel-office-reports

# Telegram — Chủ tịch nhắn tên sản phẩm trong group.
# Bot nhận việc, gửi link GitHub Pages và ảnh toàn cảnh văn phòng.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_SNAPSHOT_SECONDS=10
